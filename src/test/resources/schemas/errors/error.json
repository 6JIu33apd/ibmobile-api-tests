{
  "$schema" : "http://json-schema.org/draft-04/schema#",
  "description" : "Технические ошибки",
  "type" : "object",
  "properties" : {
        "errorCode" : { "type" : "integer", "enum" : [ 1, 2, 4, 5, 1000 ] },
        "errorDesc" : { "type" : "string" },
        "resultCode" : { "type" : "string", "enum" : [ "FAILED" ] },
        "resultMessage" : { "type" : "string" }
      },
  "required" : [ "errorCode", "errorDesc" ],
  "additionalProperties" : false
}

