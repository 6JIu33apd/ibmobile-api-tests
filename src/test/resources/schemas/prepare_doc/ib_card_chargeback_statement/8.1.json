            "resultMessage" : { "type" : "string" }
          },
          "required" : [ "responseCode", "badCount", "restCount", "cardNumber", "resultCode", "resultMessage" ],
          "additionalProperties" : false
        },
        {
          "type" : "object",
          "properties" : {
            "responseCode" : { "type" : "integer", "enum" : [ -1 ] },
            "resultCode" : { "type" : "string", "enum" : [ "NO_ACTIVE_CARD" ] },
            "resultMessage" : { "type" : "string" }
          },
          "required" : [ "responseCode", "resultCode", "resultMessage" ],
          "additionalProperties" : false
