        "qrLink" : { "type" : "string" },
        "resultCode" : { "type" : "string" },
        "resultMessage" : { "type" : "string" }
      },
      "required" : [ "responseCode", "longTicketStatus", "pk", "qrLink", "resultCode", "resultMessage" ],
      "additionalProperties" : false
    },
    "doc" : {
      "type" : "object",
      "properties" : {
