            "type" : "object",
            "properties" : {
              "operId" : { "type" : "integer" },
              "operType" : { "type" : "string" },
              "operAmount" : { "type" : "number" },
              "operCurrency" : { "type" : "string" },
              "operDate" : { "type" : "string" },
              "chargeAmount" : { "type" : "number" },
              "chargeCurrency" : { "type" : "string" },
