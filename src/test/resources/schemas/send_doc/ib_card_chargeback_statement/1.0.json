        },
        "fullName" : {
          "type" : "string"
        },
        "cardId" : {
          "type" : "integer"
        },
        "description" : {
          "type" : "string"
        },
        "reasonType" : {
          "type" : "integer"
        },
        "opersList" : {
          "type" : "array",
          "items" : {
            "type" : "integer"
          }
        },
        "srcId" : {
          "type" : "integer"
        },
        "docTypeDesc" : {
          "type" : "string"
        },
        "docStatusDesc" : {
          "type" : "string"
        },
